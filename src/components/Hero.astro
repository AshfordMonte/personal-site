---
const links = [
  { label: 'GitHub', href: 'https://github.com/AshfordMonte' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/gage-ashford/' },
  { label: 'Resume', href: '/resume.pdf' },
  { label: 'Email', href: 'mailto:ashfordmonte@gmail.com' }
];
---

<section class="hero" aria-labelledby="hero-title">
  <p class="eyebrow">Personal Site</p>
  <h1 id="hero-title">Gage Ashford</h1>
  <p class="hero-title">Network Engineer focused on ISP operations, automation, and network visibility.</p>
  <p class="hero-copy">
    I build and maintain network infrastructure, internal tooling, and operational systems for ISP
    environments. My work spans routing, wireless networks, monitoring, and automation that makes
    networks easier to operate and support.
  </p>

  <nav class="hero-links" aria-label="Primary">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</section>
